# Daily start of the PAPER engine at 09:25 America/New_York, 5 minutes
# before NYSE RTH open. OnCalendar with an explicit timezone handles DST.
#
# Holidays are NOT excluded -- on a market holiday the engine starts,
# sees no live data, and the data-freshness guard keeps it from trading.
#
# NOTE: Persistent=true makes systemd fire a missed run immediately when
# the timer is (re)started, so arming this outside market hours triggers
# one harmless off-hours start.

[Unit]
Description=Start hft_app@paper at NYSE RTH open (Mon-Fri 09:25 ET)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:25:00 America/New_York
Persistent=true
Unit=hft_app@paper.service

[Install]
WantedBy=timers.target
