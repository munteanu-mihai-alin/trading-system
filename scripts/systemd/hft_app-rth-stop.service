# Oneshot that stops the paper engine at RTH close. Because the main
# unit's Restart=on-failure ignores clean exits, this stop sticks until
# the next start.timer firing.

[Unit]
Description=Stop hft_app@paper (called by hft_app-rth-stop.timer)

[Service]
Type=oneshot
ExecStart=/bin/systemctl stop hft_app@paper.service
