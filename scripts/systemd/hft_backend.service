# Long-lived FastAPI backend that the mobile app talks to.
#
# Runs from services/ (the clean checkout). HFT_REPO selects which
# instance the ops endpoints act on -- currently the paper instance.
# Making the backend instance-aware (so it can serve both) is follow-up
# work; today it manages one at a time.

[Unit]
Description=HFT backend API (mobile app + ops)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/HC_Volume_105581071/trading-live/services
Environment=PYTHONUNBUFFERED=1
Environment=HFT_REPO=/mnt/HC_Volume_105581071/trading-live/paper
EnvironmentFile=-/etc/hft/api.env
ExecStart=/mnt/HC_Volume_105581071/trading-live/services/.venv/bin/uvicorn scripts.backend.api:app --host 0.0.0.0 --port 8088 --log-level info --access-log --ssl-keyfile /etc/hft/tls/server.key --ssl-certfile /etc/hft/tls/server.crt
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
