# Queue-driven backtest runner. Code lives in services/; the queue,
# reports and Databento caches belong to the backtest instance.

[Unit]
Description=HFT backtest launcher (queue-driven)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/HC_Volume_105581071/trading-live/backtest
Environment=HFT_REPO=/mnt/HC_Volume_105581071/trading-live/backtest
Environment=LD_LIBRARY_PATH=/mnt/HC_Volume_105581071/trading-live/services/dependencies/linux/install/lib
ExecStart=/mnt/HC_Volume_105581071/trading-live/services/scripts/hft_backtest_launcher.py
Restart=always
RestartSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
