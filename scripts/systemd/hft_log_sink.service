# Plain-HTTP debug log sink for the mobile app (WireGuard-only).

[Unit]
Description=HFT app debug log sink (plain HTTP, WireGuard-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/HC_Volume_105581071/trading-live/services
ExecStart=/usr/bin/python3 /mnt/HC_Volume_105581071/trading-live/services/scripts/backend/log_sink.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
