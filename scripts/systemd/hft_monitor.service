# Watchdog: disk, system memory, engine RSS, liveness.

[Unit]
Description=HFT engine watchdog (disk, mem, RSS, liveness)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/HC_Volume_105581071/trading-live/services
EnvironmentFile=-/etc/hft/monitor.env
ExecStart=/mnt/HC_Volume_105581071/trading-live/services/scripts/hft_monitor.py
Restart=always
RestartSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
